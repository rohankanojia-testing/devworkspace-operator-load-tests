{
  "apiVersion": "workspace.devfile.io/v1alpha2",
  "kind": "DevWorkspace",
  "metadata": {
    "name": "dw-minimal-per-workspace-storage-scale-no-git"
  },
  "spec": {
    "started": true,
    "template": {
      "attributes": {
        "controller.devfile.io/storage-type": "per-workspace"
      },
      "components": [
        {
          "name": "workspace-storage",
          "volume": {
            "size": "8Mi"
          }
        },
        {
          "name": "universal-developer-image",
          "container": {
            "image": "registry.access.redhat.com/ubi9/ubi-micro:9.6-1752751762",
            "command": ["sleep", "infinity"],
            "imagePullPolicy": "IfNotPresent",
            "mountSources": false,
            "cpuRequest": "10m",
            "cpuLimit": "50m",
            "memoryRequest": "64Mi",
            "memoryLimit": "128Mi",
            "volumeMounts": [
              {
                "name": "workspace-storage",
                "path": "/workspace-storage"
              }
            ]
          }
        }
      ]
    }
  }
}
